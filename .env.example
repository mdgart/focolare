# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------
# Local dev uses the docker-compose Postgres. In production use a hosted
# Postgres (Neon, Vercel Postgres, Supabase). Use the POOLED connection string —
# serverless functions open many short-lived connections.
DATABASE_URL=postgresql://proof:proof@localhost:5433/proof

# Session signing key. MUST be a real secret in production — there is a dev
# fallback in code, and leaving it unset makes sessions forgeable.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-minimum-length

# Both must be your real origin in production (e.g. https://focolare.app),
# or auth callbacks and emailed links will point at the wrong host.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-random-string-for-cron-route

# Comma or semicolon separated; optional quotes stripped. Must match sign-in email.
ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Local dev writes uploads to this folder and serves them from /api/files.
UPLOAD_DIR=.data/uploads
# In production, connect a Vercel Blob store and Vercel injects BLOB_READ_WRITE_TOKEN
# automatically. Its presence switches the app to CDN-backed object storage —
# REQUIRED on Vercel, because the serverless filesystem is ephemeral.
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# Required in production: password-reset links are sent over SMTP, and without it
# users who forget their password cannot recover their account. (In dev the reset
# link is printed to the server log instead.) Also powers cook-timer email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=1  # use for port 465 / implicit TLS

# ---------------------------------------------------------------------------
# Web push (optional but recommended — the free notification channel)
# Generate with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Cook timer SMS (optional, paid-plan channel). Twilio: https://www.twilio.com/docs/sms
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a Twilio phone number or a Messaging Service SID:
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------
# AI features (optional). Without a key, AI panels are hidden and content
# moderation is skipped (submissions publish unscreened).
# https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_PARSE_MODEL=gpt-5-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
